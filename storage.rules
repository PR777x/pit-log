rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Photos up to 15 MB; show videos (60 seconds or less in the app) up to 105 MB.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && ((request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024)
         || (request.resource.contentType.matches('video/.*') && request.resource.size < 105 * 1024 * 1024));
    }
  }
}
